# منارة — متغيرات البيئة
# انسخ الملف ده لـ .env.local واملأ القيم

# Supabase (قاعدة البيانات + Auth + Storage) — إلزامي
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# الدومين الرئيسي للمنصة (للتجربة المحلية استخدم lvh.me بدل localhost)
# lvh.me و *.lvh.me بيوجّهوا لـ127.0.0.1 — ضروري لاختبار الـsubdomains
NEXT_PUBLIC_ROOT_DOMAIN=manara.app
NEXT_PUBLIC_APP_URL=http://lvh.me:3000
NEXT_PUBLIC_SITE_URL=http://lvh.me:3000

# مديرو المنصة — إيميلات بفاصلة تُعطى صلاحية /admin حتى لو role≠platform_admin بعد
PLATFORM_OWNER_EMAILS=owner@example.com

# جدولة المهام الخلفية (/api/worker/run) — مفتاح سري يتحقق منه الكرون/UptimeRobot
CRON_SECRET=

# ====== Push Notifications (Web Push / VAPID) ======
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@manara.app

# ====== أمان الدخول (كود PIN الطالب) ======
# فلفل إضافي لتجزئة PIN — غيّره عن القيمة الافتراضية في الإنتاج
STUDENT_PIN_PEPPER=

# ====== Cloudflare Turnstile (حماية من الروبوتات) ======
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ====== Bunny Stream (الفيديو) ======
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_KEY=

# ====== الذكاء الاصطناعي (Gemini) — توليد أسئلة/تصحيح/مساعد ======
GEMINI_API_KEY=
GEMINI_MODEL=
# مفاتيح احتياطية إضافية (تدوير عند تجاوز الحصة) — اختياري
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GOOGLE_AI_KEY=

# نموذج ذاتي الاستضافة (vLLM/Ollama متوافق مع OpenAI) — استقلالية عن Gemini
# مثال: AGENT_LLM_URL=http://gpu-server:8000/v1
AGENT_LLM_URL=
AGENT_LLM_MODEL=
AGENT_LLM_KEY=
AGENT_LLM_TIMEOUT_MS=

# اتصال Postgres مباشر (pooler) — ذاكرة Mastra agent threads + أدوات محلية
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ====== التحصيل الأونلاين (Paymob) ======
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# ====== الإشعارات — Telegram Bot (fallback مجاني) ======
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ====== الإشعارات — WhatsApp Cloud API ======
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ====== الإشعارات — SMS (احتياطي عند تعطل Push/WhatsApp) ======
SMS_DRIVER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ====== البريد الإلكتروني ======
RESEND_API_KEY=
MAIL_FROM=noreply@manara.app

# ====== الإحالة ======
REFERRAL_LAUNCH_UNTIL=
REFERRAL_LAUNCH_DAYS=
REFEREE_REWARD_DAYS=

# ====== تطوير/اختبار فقط — لا تُفعّل في الإنتاج ======
# لو مفعّلة: رموز OTP ترجع صريحة في رد الـAPI (بدل إرسالها فعلياً) لتسهيل الاختبار
OTP_DEV_PASSTHROUGH=

# الدعم الفني (رقم واتساب يظهر في الواجهة)
NEXT_PUBLIC_SUPPORT_WHATSAPP=201025183569
