# منارة — متغيرات البيئة
# انسخ الملف ده لـ .env.local واملأ القيم

# Supabase (قاعدة البيانات + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# الدومين الرئيسي للمنصة (للتجربة المحلية استخدم lvh.me بدل localhost)
# lvh.me و *.lvh.me بيوجّهوا لـ127.0.0.1 — ضروري لاختبار الـsubdomains
NEXT_PUBLIC_ROOT_DOMAIN=manara.app
NEXT_PUBLIC_APP_URL=http://lvh.me:3000

# Bunny Stream (الفيديو) — Phase 2
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=

# الإشعارات — Telegram Bot (MVP مجاني)
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API — مرحلة متقدمة
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# الدعم الفني
NEXT_PUBLIC_SUPPORT_WHATSAPP=201200000000
